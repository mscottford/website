{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "nextjs",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc",
  ],
  "categories": {
    "correctness": "error",
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
  },
  "rules": {},
  "ignorePatterns": [
    ".next",
    "out",
    ".content-collections",
    "next-env.d.ts",
    "deploy/terraform/cloudfront-redirects.js",
  ],
}
